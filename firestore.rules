rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    // A person with an account. TVs sign in anonymously and must never count as one.
    function isSignedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Anyone with a session, TVs included
    function isAuthed() {
      return request.auth != null;
    }

    // The club that owns something: its admin or the admin's staff
    function isClub(ownerId) {
      return isSignedIn() && (request.auth.uid == ownerId || isStaffOf(ownerId));
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    
    // Check if user matches a specific ID
    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Check if user is SuperAdmin
    function isSuperAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // NEW: Check if user is Staff and belongs to a specific owner
    function isStaffOf(ownerId) {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff' && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.parentAdminId == ownerId;
    }
    
    // --- Collection Rules ---

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isUser(userId) || isSuperAdmin() || isStaffOf(userId);
      allow create: if isUser(userId) || isSuperAdmin();
      allow write: if isUser(userId) || isSuperAdmin();
    }

    // 2. Rankings (Torneos)
    match /rankings/{rankingId} {
      allow get: if true;
      
      allow list: if (isSignedIn() && (resource.data.ownerId == request.auth.uid || isStaffOf(resource.data.ownerId))) || isSuperAdmin();
      
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      allow update, delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || 
        isStaffOf(resource.data.ownerId) ||
        isSuperAdmin()
      );

      match /matches/{matchId} {
        allow get: if true;
        
        allow list: if isSignedIn() && (
          get(/databases/$(database)/documents/rankings/$(rankingId)).data.ownerId == request.auth.uid ||
          isStaffOf(get(/databases/$(database)/documents/rankings/$(rankingId)).data.ownerId) ||
          isSuperAdmin()
        );
        
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/rankings/$(rankingId)).data.ownerId == request.auth.uid ||
          isStaffOf(get(/databases/$(database)/documents/rankings/$(rankingId)).data.ownerId) ||
          isSuperAdmin()
        );
      }

      match /registrations/{regId} {
        // Public registration creation (blockedRanges, if present, is capped to keep documents small)
        allow create: if !('blockedRanges' in request.resource.data)
          || (request.resource.data.blockedRanges is list && request.resource.data.blockedRanges.size() <= 100);
        
        // Admin / Staff access to manage registrations
        allow get, list, update, delete: if isSignedIn() && (
          get(/databases/$(database)/documents/rankings/$(rankingId)).data.ownerId == request.auth.uid ||
          isStaffOf(get(/databases/$(database)/documents/rankings/$(rankingId)).data.ownerId) ||
          isSuperAdmin()
        );
      }
    }

    // 2bis. Public status mirror of tournament registrations, keyed by the player's tracking code.
    // Written only by the cloud function (Admin SDK); players read their own code only.
    match /registrationStatus/{code} {
      allow get: if true;
      allow list, write: if false;
    }

    // 3. Players
    match /players/{playerId} {
      allow get: if true;
      allow list: if (isSignedIn() && (resource.data.ownerId == request.auth.uid || isStaffOf(resource.data.ownerId))) || isSuperAdmin();
      allow write: if (isSignedIn() && (
        (resource == null && request.resource.data.ownerId == request.auth.uid) || 
        (resource != null && (resource.data.ownerId == request.auth.uid || isStaffOf(resource.data.ownerId)))
      )) || isSuperAdmin();
    }
    
    // 4. Feedback
    match /feedback/{id} {
      allow create: if isSignedIn();
      allow read: if isSuperAdmin();
      allow update: if isSuperAdmin();
    }
    
    // Club TVs (pages/ScreenPage.tsx). A TV signs in anonymously and owns screens/{its uid}.
    // Codes last 15 min from codeIssuedAt, always the server's time (TV clocks are often wrong).
    function codeIsLive(screen) {
      return screen.pairingCode != null && screen.codeIssuedAt != null
        && request.time < screen.codeIssuedAt + duration.value(15, 'm');
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Fields a club may only clear, never set
    function nullIfChanged(key) {
      return !changed().hasAny([key]) || request.resource.data.get(key, null) == null;
    }

    match /screenCodes/{code} {
      allow create: if isAuthed()
        && request.resource.data.deviceUid == request.auth.uid
        && request.resource.data.screenId == request.auth.uid
        && request.resource.data.issuedAt == request.time
        && request.resource.data.keys().hasOnly(['screenId', 'deviceUid', 'issuedAt']);
      allow get: if isSignedIn();
      allow delete: if isAuthed() && resource.data.deviceUid == request.auth.uid;
    }

    match /screens/{screenId} {
      allow create: if isAuthed()
        && screenId == request.auth.uid
        && request.resource.data.deviceUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'deviceUid', 'ownerId', 'name', 'rankingId', 'clubName', 'clubLogoUrl', 'pairingCode', 'codeIssuedAt', 'lastSeenAt', 'pairedAt'])
        && request.resource.data.ownerId == null
        && request.resource.data.rankingId == null
        && request.resource.data.get('pairingCode', null) == null
        && request.resource.data.lastSeenAt == request.time;

      // The TV may read its own id before the document exists
      allow get: if isAuthed() && (
        screenId == request.auth.uid ||
        resource.data.deviceUid == request.auth.uid ||
        (resource.data.ownerId != null && isClub(resource.data.ownerId)) ||
        isSuperAdmin()
      );

      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isStaffOf(resource.data.ownerId));

      allow update: if
        // The TV saying it is alive, or renewing its code while unpaired
        (isAuthed() && resource.data.deviceUid == request.auth.uid
          && changedOnly(['pairingCode', 'codeIssuedAt', 'lastSeenAt'])
          && (!changed().hasAny(['lastSeenAt']) || request.resource.data.lastSeenAt == request.time)
          && (!changed().hasAny(['pairingCode', 'codeIssuedAt'])
            || (resource.data.ownerId == null
              && request.resource.data.pairingCode is string
              && request.resource.data.codeIssuedAt == request.time)))
        // A club pairing an unpaired TV with the code it shows now
        || (resource.data.ownerId == null
          && isClub(request.resource.data.ownerId)
          && codeIsLive(resource.data)
          && request.resource.data.claimCode == resource.data.pairingCode
          && request.resource.data.pairingCode == null
          && request.resource.data.codeIssuedAt == null
          && changedOnly(['ownerId', 'name', 'rankingId', 'clubName', 'clubLogoUrl', 'pairedAt', 'pairingCode', 'codeIssuedAt', 'claimCode']))
        // The club managing its TV, or unpairing it
        || (resource.data.ownerId != null && isClub(resource.data.ownerId)
          && changedOnly(['name', 'rankingId', 'clubName', 'clubLogoUrl', 'ownerId', 'pairedAt', 'pairingCode', 'codeIssuedAt', 'claimCode'])
          && nullIfChanged('pairingCode') && nullIfChanged('codeIssuedAt') && nullIfChanged('claimCode')
          && (request.resource.data.ownerId == resource.data.ownerId
            || (request.resource.data.ownerId == null && request.resource.data.rankingId == null)));
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
